{
  "manifest_version": 3,
  "name": "Hunyuan 3D — English UI & Hints",
  "version": "0.2.0",
  "description": "Unofficial: switches 3d.hunyuan.tencent.com to English, polishes the wording and adds tooltips for 3D terms.",
  "content_scripts": [
    {
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ],
      "js": [
        "src/overrides.js",
        "src/i18n-hook.js",
        "src/dict.js",
        "src/dom-translate.js",
        "src/hints-data.js",
        "src/hints.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ],
      "css": [
        "src/theme.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ]
    }
  ]
}
