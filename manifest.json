{
  "manifest_version": 3,
  "name": "Hunyuan 3D — English UI, Hints & Accounts",
  "version": "0.4.0",
  "description": "Unofficial: switches 3d.hunyuan.tencent.com to English, adds tooltips for 3D terms and one-click switching between your accounts.",
  "content_scripts": [
    {
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ],
      "js": [
        "src/overrides.js",
        "src/i18n-hook.js",
        "src/dict.js",
        "src/dom-translate.js",
        "src/hints-data.js",
        "src/hints.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ],
      "css": [
        "src/theme.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ]
    }
  ],
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.tencent.com/*",
    "http://*.tencent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Hunyuan 3D accounts"
  }
}
