{
  "manifest_version": 3,
  "name": "Hunyuan 3D — English UI, Hints & Accounts",
  "version": "0.5.0",
  "description": "Unofficial: Hunyuan 3D (3d.hunyuan.tencent.com) in English or Russian, 3D term tooltips, account switcher, prompt translation, model library.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Hunyuan 3D",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "notifications",
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://3d.hunyuan.tencent.com/*"
  ],
  "optional_host_permissions": [
    "https://*.tencent.com/*",
    "http://*.tencent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ],
      "js": [
        "src/defaults.js",
        "src/settings.js",
        "src/overrides.js",
        "src/i18n-ru.js",
        "src/i18n-hook.js",
        "src/dict.js",
        "src/dom-translate.js",
        "src/hints-data.js",
        "src/hints.js",
        "src/features.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "css": [
        "src/theme.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ]
    }
  ]
}
